@model HELPDESK.Models.Configuracion.ConfiguracionGeneral.configuracionGeneralModel
@{
    ViewData["Title"] = "Configuracion general";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Configuracion general - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Modulos/modulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/ConfiguracionGeneral/configuracionGeneral.css")" />
</head>
<body>
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Configuracion</span>
                    <h1>Configuracion general</h1>
                </div>
            </header>

            <section class="catalog-layout">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) {
                    <div class="catalog-alert success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    <div class="catalog-alert error">@Model.ErrorMessage</div>
                }

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Nueva configuracion</h2>
                            <p>Registra parametros que controlan rutas, limites y valores generales del sistema.</p>
                        </div>
                    </div>

                    <form action="@Url.Action("Create", "configuracionGeneral")" method="post" class="catalog-form system-config-form">
                        @Html.AntiForgeryToken()
                        <div class="form-field">
                            <label for="Clave">Nombre del parametro</label>
                            <input id="Clave" name="Clave" type="text" maxlength="100" required autocomplete="off" placeholder="Ej. RutaEvidenciasTickets" />
                        </div>
                        <div class="form-field wide">
                            <label for="Valor">Valor configurado</label>
                            <textarea id="Valor" name="Valor" rows="3" required placeholder="Ej. wwwroot\Evidencias\Tickets"></textarea>
                        </div>
                        <div class="form-field full">
                            <label for="Descripcion">Para que se utiliza</label>
                            <input id="Descripcion" name="Descripcion" type="text" maxlength="250" autocomplete="off" placeholder="Ej. Ruta donde se guardan las evidencias de tickets." />
                        </div>
                        <button type="submit" class="btn-primary">
                            <i class="fa-solid fa-plus"></i>
                            Agregar
                        </button>
                    </form>
                </div>

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Listado de configuraciones</h2>
                            <p>Administra parametros utilizados por diferentes modulos.</p>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table class="catalog-table system-config-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Parametro</th>
                                    <th>Valor configurado</th>
                                    <th>Uso</th>
                                    <th>Fecha alta</th>
                                    <th>Estatus</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Configuraciones.Count == 0) {
                                    <tr>
                                        <td colspan="7" class="empty-cell">No hay configuraciones registradas.</td>
                                    </tr>
                                } else {
                                    foreach (var item in Model.Configuraciones) {
                                        <tr>
                                            <td>@item.IdConfiguracionSistema</td>
                                            <td>@item.Clave</td>
                                            <td class="value-cell">@item.Valor</td>
                                            <td>@item.Descripcion</td>
                                            <td>@item.FechaAlta.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="status-pill @(item.Activo ? "active" : "inactive")">
                                                    @(item.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="row-actions">
                                                    <button type="button"
                                                            class="icon-action"
                                                            data-edit-id="@item.IdConfiguracionSistema"
                                                            data-edit-key="@item.Clave"
                                                            data-edit-value="@item.Valor"
                                                            data-edit-description="@item.Descripcion"
                                                            aria-label="Editar configuracion">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>

                                                    <form action="@Url.Action("ToggleActivo", "configuracionGeneral")" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idConfiguracionSistema" value="@item.IdConfiguracionSistema" />
                                                        <button type="submit" class="icon-action" aria-label="Cambiar estatus">
                                                            <i class="fa-solid @(item.Activo ? "fa-ban" : "fa-check")"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <div class="modal-backdrop" id="editModal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="editTitle">
            <div class="modal-header">
                <h2 id="editTitle">Editar configuracion</h2>
                <button type="button" class="modal-close" id="btnCloseModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form action="@Url.Action("Edit", "configuracionGeneral")" method="post" class="catalog-form stacked">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdConfiguracionSistema" name="IdConfiguracionSistema" />
                <div class="form-field">
                    <label for="editClave">Nombre del parametro</label>
                    <input id="editClave" name="Clave" type="text" maxlength="100" required autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editValor">Valor configurado</label>
                    <textarea id="editValor" name="Valor" rows="4" required></textarea>
                </div>
                <div class="form-field">
                    <label for="editDescripcion">Para que se utiliza</label>
                    <input id="editDescripcion" name="Descripcion" type="text" maxlength="250" autocomplete="off" />
                </div>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar cambios
                </button>
            </form>
        </div>
    </div>

    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Configuracion/ConfiguracionGeneral/configuracionGeneral.js")"></script>
</body>
</html>
