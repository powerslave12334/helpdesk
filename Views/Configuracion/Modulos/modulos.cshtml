@model HELPDESK.Models.Configuracion.Modulos.modulosModel
@{
    ViewData["Title"] = "Módulos";
    Layout = null;
    int idUsuario = 0;
    int.TryParse(Context.Session.GetString("IdUsuario"), out idUsuario);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Módulos - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Modulos/modulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Notificaciones/notificaciones.css")" />
</head>
<body data-user-id="@idUsuario">
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Configuración</span>
                    <h1>Módulos</h1>
                </div>
            </header>

            <section class="catalog-layout">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) {
                    <div class="catalog-alert success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    <div class="catalog-alert error">@Model.ErrorMessage</div>
                }

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Nuevo módulo</h2>
                            <p>Registra las secciones principales del sistema.</p>
                        </div>
                    </div>

                    <form action="@Url.Action("Create", "modulos")" method="post" class="catalog-form module-form">
                        @Html.AntiForgeryToken()
                        <div class="form-field">
                            <label for="Nombre">Nombre</label>
                            <input id="Nombre" name="Nombre" type="text" maxlength="50" required autocomplete="off" />
                        </div>
                        <div class="form-field">
                            <label for="Orden">Orden</label>
                            <input id="Orden" name="Orden" type="number" min="0" value="0" required autocomplete="off" />
                        </div>
                        <button type="submit" class="btn-primary">
                            <i class="fa-solid fa-plus"></i>
                            Agregar
                        </button>
                    </form>
                </div>

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Listado de módulos</h2>
                            <p>Administra el nombre y estatus de cada módulo.</p>
                        </div>
                        <div class="table-search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" id="searchInput" placeholder="Buscar por nombre..." />
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table id="dataTable" class="catalog-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre</th>
                                    <th>Orden</th>
                                    <th>Fecha alta</th>
                                    <th>Estatus</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                @if (Model.Modulos.Count == 0) {
                                    <tr>
                                        <td colspan="6" class="empty-cell">No hay módulos registrados.</td>
                                    </tr>
                                } else {
                                    foreach (var item in Model.Modulos) {
                                        <tr>
                                            <td>@item.IdModulos</td>
                                            <td>@item.Nombre</td>
                                            <td>@item.Orden</td>
                                            <td>@item.FechaAlta.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="status-pill @(item.Activo ? "active" : "inactive")">
                                                    @(item.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="row-actions">
                                                    <button type="button"
                                                            class="icon-action"
                                                            data-edit-id="@item.IdModulos"
                                                            data-edit-name="@item.Nombre"
                                                            data-edit-order="@item.Orden"
                                                            aria-label="Editar módulo">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>

                                                    <form action="@Url.Action("ToggleActivo", "modulos")" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idModulos" value="@item.IdModulos" />
                                                        <button type="submit" class="icon-action" aria-label="Cambiar estatus">
                                                            <i class="fa-solid @(item.Activo ? "fa-ban" : "fa-check")"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <div class="table-footer" id="tableFooter">
                            <div class="table-info" id="rowCount"></div>
                            <div class="pagination" id="pagination"></div>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <div class="modal-backdrop" id="editModal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="editTitle">
            <div class="modal-header">
                <h2 id="editTitle">Editar módulo</h2>
                <button type="button" class="modal-close" id="btnCloseModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form action="@Url.Action("Edit", "modulos")" method="post" class="catalog-form stacked">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdModulos" name="IdModulos" />
                <div class="form-field">
                    <label for="editNombre">Nombre</label>
                    <input id="editNombre" name="Nombre" type="text" maxlength="50" required autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editOrden">Orden</label>
                    <input id="editOrden" name="Orden" type="number" min="0" required autocomplete="off" />
                </div>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar cambios
                </button>
            </form>
        </div>
    </div>

    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Configuracion/Modulos/modulos.js")"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="@Url.Content("~/js/Notificaciones/notificaciones.js")"></script>
</body>
</html>
