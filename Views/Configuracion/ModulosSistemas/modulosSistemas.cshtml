@model HELPDESK.Models.Configuracion.ModulosSistemas.modulosSistemasModel
@{
    ViewData["Title"] = "Modulos de sistemas";
    Layout = null;
    int idUsuario = 0;
    int.TryParse(Context.Session.GetString("IdUsuario"), out idUsuario);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Modulos de sistemas - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Modulos/modulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/ModulosSistemas/modulosSistemas.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Notificaciones/notificaciones.css")" />
</head>
<body data-user-id="@idUsuario">
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Configuracion</span>
                    <h1>Modulos de sistemas</h1>
                </div>
            </header>

            <section class="catalog-layout">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) {
                    <div class="catalog-alert success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    <div class="catalog-alert error">@Model.ErrorMessage</div>
                }

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Nuevo modulo de sistema</h2>
                            <p>Registra modulos y asocialos a un sistema activo.</p>
                        </div>
                    </div>

                    <form action="@Url.Action("Create", "modulosSistemas")" method="post" class="catalog-form system-modules-form">
                        @Html.AntiForgeryToken()
                        <div class="form-field system-field">
                            <label for="IdSistemas">Sistema</label>
                            <select id="IdSistemas" name="IdSistemas" required>
                                <option value="">Seleccione</option>
                                @foreach (var sistema in Model.Sistemas) {
                                    <option value="@sistema.IdSistemas">@sistema.Sistema</option>
                                }
                            </select>
                        </div>
                        <div class="form-field module-name-field">
                            <label for="Nombre">Nombre del modulo</label>
                            <input id="Nombre" name="Nombre" type="text" maxlength="100" required autocomplete="off" />
                        </div>
                        <button type="submit" class="btn-primary">
                            <i class="fa-solid fa-plus"></i>
                            Agregar
                        </button>
                    </form>
                </div>

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Listado de modulos de sistemas</h2>
                            <p>Administra los modulos disponibles por sistema.</p>
                        </div>
                        <div class="table-search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" id="searchInput" placeholder="Buscar por modulo o sistema..." />
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table id="dataTable" class="catalog-table system-modules-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Modulo</th>
                                    <th>Sistema</th>
                                    <th>Estatus</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                @if (Model.ModulosSistemas.Count == 0) {
                                    <tr>
                                        <td colspan="5" class="empty-cell">No hay modulos de sistemas registrados.</td>
                                    </tr>
                                } else {
                                    foreach (var item in Model.ModulosSistemas) {
                                        <tr>
                                            <td>@item.IdModulosSistemas</td>
                                            <td>@item.Nombre</td>
                                            <td>@item.Sistema</td>
                                            <td>
                                                <span class="status-pill @(item.Enabled ? "active" : "inactive")">
                                                    @(item.Enabled ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="row-actions">
                                                    <button type="button"
                                                            class="icon-action"
                                                            data-edit-id="@item.IdModulosSistemas"
                                                            data-edit-name="@item.Nombre"
                                                            data-edit-system="@item.IdSistemas"
                                                            aria-label="Editar modulo de sistema">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>

                                                    <form action="@Url.Action("ToggleEnabled", "modulosSistemas")" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idModulosSistemas" value="@item.IdModulosSistemas" />
                                                        <button type="submit" class="icon-action" aria-label="Cambiar estatus">
                                                            <i class="fa-solid @(item.Enabled ? "fa-ban" : "fa-check")"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <div class="table-footer" id="tableFooter">
                            <div class="table-info" id="rowCount"></div>
                            <div class="pagination" id="pagination"></div>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <div class="modal-backdrop" id="editModal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="editTitle">
            <div class="modal-header">
                <h2 id="editTitle">Editar modulo de sistema</h2>
                <button type="button" class="modal-close" id="btnCloseModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form action="@Url.Action("Edit", "modulosSistemas")" method="post" class="catalog-form stacked system-modules-edit-form">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdModulosSistemas" name="IdModulosSistemas" />
                <div class="form-field system-field">
                    <label for="editIdSistemas">Sistema</label>
                    <select id="editIdSistemas" name="IdSistemas" required>
                        <option value="">Seleccione</option>
                        @foreach (var sistema in Model.Sistemas) {
                            <option value="@sistema.IdSistemas">@sistema.Sistema</option>
                        }
                    </select>
                </div>
                <div class="form-field module-name-field">
                    <label for="editNombre">Nombre del modulo</label>
                    <input id="editNombre" name="Nombre" type="text" maxlength="100" required autocomplete="off" />
                </div>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar cambios
                </button>
            </form>
        </div>
    </div>

    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Configuracion/ModulosSistemas/modulosSistemas.js")"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="@Url.Content("~/js/Notificaciones/notificaciones.js")"></script>
</body>
</html>
