@model HELPDESK.Models.Configuracion.PermisoUsuarios.permisoUsuariosModel
@using HELPDESK.Models.Configuracion.PermisoUsuarios
@{
    ViewData["Title"] = "Permisos por usuario";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Permisos por usuario - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Modulos/modulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/SubModulos/subModulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/RolPermisos/rolPermiso.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/PermisoUsuarios/permisoUsuarios.css")" />
</head>
<body>
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Configuracion</span>
                    <h1>Permisos por usuario</h1>
                </div>
            </header>

            <section class="catalog-layout">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) {
                    <div class="catalog-alert success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    <div class="catalog-alert error">@Model.ErrorMessage</div>
                }

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Seleccionar usuario</h2>
                            <p>Elige un usuario para cargar y modificar sus permisos directos.</p>
                        </div>
                    </div>

                    <form action="@Url.Action("Index", "permisoUsuarios")" method="get" class="catalog-form user-filter-form">
                        <div class="form-field">
                            <label for="IdUsuarioFiltro">Usuario</label>
                            <select id="IdUsuarioFiltro" name="idUsuario" required>
                                <option value="">Selecciona un usuario</option>
                                @foreach (var usuario in Model.Usuarios) {
                                    if (Model.IdUsuario == usuario.IdUsuario) {
                                        <option value="@usuario.IdUsuario" selected>@usuario.NombreUsuario</option>
                                    } else {
                                        <option value="@usuario.IdUsuario">@usuario.NombreUsuario</option>
                                    }
                                }
                            </select>
                        </div>
                    </form>
                </div>

                @if (Model.IdUsuario > 0) {
                    <form action="@Url.Action("GuardarMatriz", "permisoUsuarios")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />

                        <div class="catalog-panel">
                            <div class="catalog-panel-header permission-header">
                                <div>
                                    <h2>Matriz de permisos directos</h2>
                                    <p>Marca permisos directos; los desmarcados dejan aplicar los permisos del rol.</p>
                                </div>
                                <label class="check-field master-check">
                                    <input type="checkbox" id="checkAllPermissions" />
                                    <span>Seleccionar todo</span>
                                </label>
                            </div>

                            <div class="table-wrap">
                                <table class="catalog-table permission-matrix">
                                    <thead>
                                        <tr>
                                            <th>Modulo</th>
                                            <th>Submodulo</th>
                                            <th>Fila</th>
                                            @foreach (var accion in Model.Acciones) {
                                                <th>@accion.NombreAccion</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.SubModulos.Count == 0 || Model.Acciones.Count == 0) {
                                            <tr>
                                                <td colspan="@(Model.Acciones.Count + 3)" class="empty-cell">No hay submodulos o acciones activas para configurar.</td>
                                            </tr>
                                        } else {
                                            foreach (var modulo in Model.Modulos) {
                                                var subModulos = Model.SubModulos
                                                    .Where(item => item.IdModulo == modulo.IdModulo)
                                                    .ToList();

                                                foreach (var subModulo in subModulos) {
                                                    <tr>
                                                        <td>@modulo.NombreModulo</td>
                                                        <td>@subModulo.NombreSubModulo</td>
                                                        <td>
                                                            <label class="matrix-check compact-check">
                                                                <input type="checkbox" class="row-check" />
                                                                <span>Todo</span>
                                                            </label>
                                                        </td>
                                                        @foreach (var accion in Model.Acciones) {
                                                            string value = permisoUsuariosModel.CrearLlavePermiso(modulo.IdModulo, subModulo.IdSubModulo, accion.IdAccion);
                                                            bool permitido = Model.PermisoActivo(modulo.IdModulo, subModulo.IdSubModulo, accion.IdAccion);

                                                            <td>
                                                                <label class="matrix-check" title="@accion.NombreAccion">
                                                                    @if (permitido) {
                                                                        <input type="checkbox"
                                                                               class="permission-check"
                                                                               name="PermisosSeleccionados"
                                                                               value="@value"
                                                                               checked />
                                                                    } else {
                                                                        <input type="checkbox"
                                                                               class="permission-check"
                                                                               name="PermisosSeleccionados"
                                                                               value="@value" />
                                                                    }
                                                                    <span class="sr-only">@accion.NombreAccion</span>
                                                                </label>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="matrix-actions">
                                <button type="submit" class="btn-primary">
                                    <i class="fa-solid fa-floppy-disk"></i>
                                    Guardar permisos
                                </button>
                            </div>
                        </div>
                    </form>
                }
            </section>
        </main>
    </div>

    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Configuracion/PermisoUsuarios/permisoUsuarios.js")"></script>
</body>
</html>
