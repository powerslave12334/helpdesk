@model HELPDESK.Models.Configuracion.Roles.rolesModel
@{
    ViewData["Title"] = "Roles";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Roles - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Modulos/modulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Roles/roles.css")" />
</head>
<body>
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Configuración</span>
                    <h1>Roles</h1>
                </div>
            </header>

            <section class="catalog-layout">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) {
                    <div class="catalog-alert success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    <div class="catalog-alert error">@Model.ErrorMessage</div>
                }

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Nuevo rol</h2>
                            <p>Registra perfiles que después recibirán permisos.</p>
                        </div>
                    </div>

                    <form action="@Url.Action("Create", "roles")" method="post" class="catalog-form role-form">
                        @Html.AntiForgeryToken()
                        <div class="form-field">
                            <label for="Nombre">Nombre</label>
                            <input id="Nombre" name="Nombre" type="text" maxlength="50" required autocomplete="off" placeholder="Administrador, Técnico..." />
                        </div>
                        <div class="form-field">
                            <label for="Descripcion">Descripción</label>
                            <input id="Descripcion" name="Descripcion" type="text" maxlength="50" required autocomplete="off" />
                        </div>
                        <button type="submit" class="btn-primary">
                            <i class="fa-solid fa-plus"></i>
                            Agregar
                        </button>
                    </form>
                </div>

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Listado de roles</h2>
                            <p>Administra los perfiles de acceso del sistema.</p>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table class="catalog-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre</th>
                                    <th>Descripción</th>
                                    <th>Fecha alta</th>
                                    <th>Estatus</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Roles.Count == 0) {
                                    <tr>
                                        <td colspan="6" class="empty-cell">No hay roles registrados.</td>
                                    </tr>
                                } else {
                                    foreach (var item in Model.Roles) {
                                        <tr>
                                            <td>@item.IdRol</td>
                                            <td>@item.Nombre</td>
                                            <td>@item.Descripcion</td>
                                            <td>@item.FechaAlta.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="status-pill @(item.Activo ? "active" : "inactive")">
                                                    @(item.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="row-actions">
                                                    <button type="button"
                                                            class="icon-action"
                                                            data-edit-id="@item.IdRol"
                                                            data-edit-name="@item.Nombre"
                                                            data-edit-description="@item.Descripcion"
                                                            aria-label="Editar rol">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>

                                                    <form action="@Url.Action("ToggleActivo", "roles")" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idRol" value="@item.IdRol" />
                                                        <button type="submit" class="icon-action" aria-label="Cambiar estatus">
                                                            <i class="fa-solid @(item.Activo ? "fa-ban" : "fa-check")"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <div class="modal-backdrop" id="editModal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="editTitle">
            <div class="modal-header">
                <h2 id="editTitle">Editar rol</h2>
                <button type="button" class="modal-close" id="btnCloseModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form action="@Url.Action("Edit", "roles")" method="post" class="catalog-form stacked">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdRol" name="IdRol" />
                <div class="form-field">
                    <label for="editNombre">Nombre</label>
                    <input id="editNombre" name="Nombre" type="text" maxlength="50" required autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editDescripcion">Descripción</label>
                    <input id="editDescripcion" name="Descripcion" type="text" maxlength="50" required autocomplete="off" />
                </div>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar cambios
                </button>
            </form>
        </div>
    </div>

    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Configuracion/Roles/roles.js")"></script>
</body>
</html>
