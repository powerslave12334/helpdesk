@model HELPDESK.Models.Configuracion.SubModulos.subModulosModel
@{
    ViewData["Title"] = "Submodulos";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Submodulos - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Modulos/modulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/SubModulos/subModulos.css")" />
</head>
<body>
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Configuracion</span>
                    <h1>Submodulos</h1>
                </div>
            </header>

            <section class="catalog-layout">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) {
                    <div class="catalog-alert success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    <div class="catalog-alert error">@Model.ErrorMessage</div>
                }

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Nuevo submodulo</h2>
                            <p>Relaciona una opcion de trabajo con su modulo principal y ruta MVC.</p>
                        </div>
                    </div>

                    <form action="@Url.Action("Create", "subModulos")" method="post" class="catalog-form submodule-form">
                        @Html.AntiForgeryToken()
                        <div class="form-field">
                            <label for="IdModulo">Modulo</label>
                            <select id="IdModulo" name="IdModulo" required>
                                <option value="">Selecciona un modulo</option>
                                @foreach (var modulo in Model.Modulos) {
                                    <option value="@modulo.IdModulo">@modulo.NombreModulo</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label for="Nombre">Nombre</label>
                            <input id="Nombre" name="Nombre" type="text" maxlength="50" required autocomplete="off" />
                        </div>
                        <div class="form-field">
                            <label for="Orden">Orden</label>
                            <input id="Orden" name="Orden" type="number" min="0" value="0" required autocomplete="off" />
                        </div>
                        <div class="form-field">
                            <label for="Controller">Controller</label>
                            <input id="Controller" name="Controller" type="text" maxlength="100" required autocomplete="off" />
                        </div>
                        <div class="form-field">
                            <label for="Action">Action</label>
                            <input id="Action" name="Action" type="text" maxlength="50" required autocomplete="off" value="Index" />
                        </div>
                        <button type="submit" class="btn-primary">
                            <i class="fa-solid fa-plus"></i>
                            Agregar
                        </button>
                    </form>
                </div>

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Listado de submodulos</h2>
                            <p>Administra las opciones disponibles dentro de cada modulo.</p>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table class="catalog-table submodule-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Modulo</th>
                                    <th>Submodulo</th>
                                    <th>Orden</th>
                                    <th>Controller</th>
                                    <th>Action</th>
                                    <th>Fecha alta</th>
                                    <th>Estatus</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.SubModulos.Count == 0) {
                                    <tr>
                                        <td colspan="9" class="empty-cell">No hay submodulos registrados.</td>
                                    </tr>
                                } else {
                                    foreach (var item in Model.SubModulos) {
                                        <tr>
                                            <td>@item.IdSubModulos</td>
                                            <td>@item.NombreModulo</td>
                                            <td>@item.Nombre</td>
                                            <td>@item.Orden</td>
                                            <td>@item.Controller</td>
                                            <td>@item.Action</td>
                                            <td>@item.FechaAlta.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="status-pill @(item.Activo ? "active" : "inactive")">
                                                    @(item.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="row-actions">
                                                    <button type="button"
                                                            class="icon-action"
                                                            data-edit-id="@item.IdSubModulos"
                                                            data-edit-module="@item.IdModulo"
                                                            data-edit-name="@item.Nombre"
                                                            data-edit-order="@item.Orden"
                                                            data-edit-controller="@item.Controller"
                                                            data-edit-action="@item.Action"
                                                            aria-label="Editar submodulo">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>

                                                    <form action="@Url.Action("ToggleActivo", "subModulos")" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idSubModulos" value="@item.IdSubModulos" />
                                                        <button type="submit" class="icon-action" aria-label="Cambiar estatus">
                                                            <i class="fa-solid @(item.Activo ? "fa-ban" : "fa-check")"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <div class="modal-backdrop" id="editModal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="editTitle">
            <div class="modal-header">
                <h2 id="editTitle">Editar submodulo</h2>
                <button type="button" class="modal-close" id="btnCloseModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form action="@Url.Action("Edit", "subModulos")" method="post" class="catalog-form stacked">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdSubModulos" name="IdSubModulos" />
                <div class="form-field">
                    <label for="editIdModulo">Modulo</label>
                    <select id="editIdModulo" name="IdModulo" required>
                        <option value="">Selecciona un modulo</option>
                        @foreach (var modulo in Model.Modulos) {
                            <option value="@modulo.IdModulo">@modulo.NombreModulo</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="editNombre">Nombre</label>
                    <input id="editNombre" name="Nombre" type="text" maxlength="50" required autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editOrden">Orden</label>
                    <input id="editOrden" name="Orden" type="number" min="0" required autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editController">Controller</label>
                    <input id="editController" name="Controller" type="text" maxlength="100" required autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editAction">Action</label>
                    <input id="editAction" name="Action" type="text" maxlength="50" required autocomplete="off" />
                </div>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar cambios
                </button>
            </form>
        </div>
    </div>

    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Configuracion/SubModulos/subModulos.js")"></script>
</body>
</html>
