@model HELPDESK.Models.Configuracion.SubmodulosSistemas.submodulosSistemasModel
@{
    ViewData["Title"] = "Submodulos Sistemas";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Submodulos Sistemas - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Modulos/modulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/SubmodulosSistemas/submodulosSistemas.css")" />
</head>
<body>
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Configuracion</span>
                    <h1>Submodulos Sistemas</h1>
                </div>
            </header>

            <section class="catalog-layout">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) {
                    <div class="catalog-alert success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    <div class="catalog-alert error">@Model.ErrorMessage</div>
                }

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Nuevo submodulo de sistema</h2>
                            <p>Selecciona un sistema, el modulo correspondiente y captura el submodulo.</p>
                        </div>
                    </div>

                    <form action="@Url.Action("Create", "submodulosSistemas")" method="post" class="catalog-form system-submodules-form">
                        @Html.AntiForgeryToken()
                        <div class="form-field system-field">
                            <label for="IdSistemas">Sistema</label>
                            <select id="IdSistemas" name="IdSistemas" data-modules-target="IdModulosSistemas" required>
                                <option value="">Seleccione</option>
                                @foreach (var sistema in Model.Sistemas) {
                                    <option value="@sistema.IdSistemas">@sistema.Sistema</option>
                                }
                            </select>
                        </div>
                        <div class="form-field module-field">
                            <label for="IdModulosSistemas">Modulo</label>
                            <select id="IdModulosSistemas" name="IdModulosSistemas" required disabled>
                                <option value="">Seleccione un sistema</option>
                            </select>
                        </div>
                        <div class="form-field submodule-name-field">
                            <label for="Nombre">Submodulo</label>
                            <input id="Nombre" name="Nombre" type="text" maxlength="100" required autocomplete="off" />
                        </div>
                        <button type="submit" class="btn-primary">
                            <i class="fa-solid fa-plus"></i>
                            Agregar
                        </button>
                    </form>
                </div>

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Listado de submodulos de sistemas</h2>
                            <p>Administra los submodulos disponibles por modulo y sistema.</p>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table class="catalog-table system-submodules-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Submodulo</th>
                                    <th>Modulo</th>
                                    <th>Sistema</th>
                                    <th>Estatus</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.SubmodulosSistemas.Count == 0) {
                                    <tr>
                                        <td colspan="6" class="empty-cell">No hay submodulos de sistemas registrados.</td>
                                    </tr>
                                } else {
                                    foreach (var item in Model.SubmodulosSistemas) {
                                        <tr>
                                            <td>@item.IdSubmodulosSistemas</td>
                                            <td>@item.Nombre</td>
                                            <td>@item.ModuloSistema</td>
                                            <td>@item.Sistema</td>
                                            <td>
                                                <span class="status-pill @(item.Enabled ? "active" : "inactive")">
                                                    @(item.Enabled ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="row-actions">
                                                    <button type="button"
                                                            class="icon-action"
                                                            data-edit-id="@item.IdSubmodulosSistemas"
                                                            data-edit-name="@item.Nombre"
                                                            data-edit-system="@item.IdSistemas"
                                                            data-edit-module="@item.IdModulosSistemas"
                                                            aria-label="Editar submodulo de sistema">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>

                                                    <form action="@Url.Action("ToggleEnabled", "submodulosSistemas")" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idSubmodulosSistemas" value="@item.IdSubmodulosSistemas" />
                                                        <button type="submit" class="icon-action" aria-label="Cambiar estatus">
                                                            <i class="fa-solid @(item.Enabled ? "fa-ban" : "fa-check")"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <div class="modal-backdrop" id="editModal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="editTitle">
            <div class="modal-header">
                <h2 id="editTitle">Editar submodulo de sistema</h2>
                <button type="button" class="modal-close" id="btnCloseModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form action="@Url.Action("Edit", "submodulosSistemas")" method="post" class="catalog-form stacked system-submodules-edit-form">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdSubmodulosSistemas" name="IdSubmodulosSistemas" />
                <div class="form-field system-field">
                    <label for="editIdSistemas">Sistema</label>
                    <select id="editIdSistemas" name="IdSistemas" data-modules-target="editIdModulosSistemas" required>
                        <option value="">Seleccione</option>
                        @foreach (var sistema in Model.Sistemas) {
                            <option value="@sistema.IdSistemas">@sistema.Sistema</option>
                        }
                    </select>
                </div>
                <div class="form-field module-field">
                    <label for="editIdModulosSistemas">Modulo</label>
                    <select id="editIdModulosSistemas" name="IdModulosSistemas" required disabled>
                        <option value="">Seleccione un sistema</option>
                    </select>
                </div>
                <div class="form-field submodule-name-field">
                    <label for="editNombre">Submodulo</label>
                    <input id="editNombre" name="Nombre" type="text" maxlength="100" required autocomplete="off" />
                </div>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar cambios
                </button>
            </form>
        </div>
    </div>

    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Configuracion/SubmodulosSistemas/submodulosSistemas.js")"></script>
</body>
</html>
