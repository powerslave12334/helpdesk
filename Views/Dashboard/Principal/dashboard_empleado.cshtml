@model HELPDESK.Models.Dashboard.dashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
    int idUsuario = 0;
    int.TryParse(Context.Session.GetString("IdUsuario"), out idUsuario);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Notificaciones/notificaciones.css")" />
</head>
<body>
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Panel de trabajo</span>
                    <h1 id="workspaceTitle">Dashboard</h1>
                </div>
                <div class="user-chip">
                    <div class="notif-wrapper" id="notifBell">
                        <div class="notif-bell">
                            <i class="fa-solid fa-bell"></i>
                            <span class="notif-badge" id="notifBadge">@Model.NotificacionesNoLeidas</span>
                        </div>
                        <div class="notif-panel" id="notifPanel">
                            <div class="notif-panel-header">
                                <h3>Notificaciones</h3>
                                <button class="notif-mark-all" id="notifMarkAll">Marcar todo leido</button>
                            </div>
                            <div class="notif-list" id="notifList">
                                <div class="notif-empty"><i class="fa-solid fa-bell-slash"></i>Sin notificaciones</div>
                            </div>
                        </div>
                    </div>
                    <span class="user-dot"></span>
                    <span>@Model.NombreUsuario</span>
                </div>
            </header>

            <section class="workspace-content" id="workspaceContent">
                <div class="recent-card">
                    <div class="recent-header">
                        <h3><i class="fa-solid fa-ticket"></i> Mis tickets</h3>
                    </div>
                    <div class="table-wrap">
                        <table class="recent-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Asunto</th>
                                    <th>Tipo</th>
                                    <th>Estatus</th>
                                    <th>Fecha</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.MisTickets.Count > 0) {
                                    @foreach (var t in Model.MisTickets) {
                                        <tr>
                                            <td class="cell-id">@t.IdTicket</td>
                                            <td>@t.Asunto</td>
                                            <td><span class="pill pill-type">@t.TipoSoporte</span></td>
                                            <td><span class="pill pill-status">@t.Estatus</span></td>
                                            <td class="cell-date">@t.FechaAlta.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                } else {
                                    <tr>
                                        <td colspan="5" class="cell-empty">No tienes tickets registrados</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Notificaciones/notificaciones.js")"></script>
    <script>
        HelpDeskNotifications.init(@idUsuario);
    </script>
</body>
</html>
