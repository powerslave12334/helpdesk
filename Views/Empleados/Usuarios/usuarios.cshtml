@model HELPDESK.Models.Empleados.Usuarios.usuariosModel
@{
    ViewData["Title"] = "Registrar empleados";
    Layout = null;
    int idUsuario = 0;
    int.TryParse(Context.Session.GetString("IdUsuario"), out idUsuario);
    string soloLecturaLaboral = Model.PuedeEditarDatosLaborales ? string.Empty : "disabled";
    int idUsuarioSesion = Convert.ToInt32(ViewBag.IdUsuarioSesion ?? 0);
    bool esAdministradorUsuarios = Convert.ToBoolean(ViewBag.EsAdministradorUsuarios ?? false);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registrar empleados - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Modulos/modulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Empleados/Usuarios/usuarios.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Notificaciones/notificaciones.css")" />
</head>
<body data-user-id="@idUsuario">
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Empleados</span>
                    <h1>Registrar empleados</h1>
                </div>
            </header>

            <section class="catalog-layout">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) {
                    <div class="catalog-alert success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    <div class="catalog-alert error">@Model.ErrorMessage</div>
                }

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Listado de empleados</h2>
                            <p>Administra empleados registrados en el sistema.</p>
                        </div>
                        @if (Model.PuedeCrear) {
                            <button type="button" class="btn-primary" id="btnOpenCreateModal">
                                <i class="fa-solid fa-plus"></i>
                                Agregar empleado
                            </button>
                        }
                        <div class="table-search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" id="searchInput" placeholder="Buscar por nombre, contacto o departamento..." />
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table class="catalog-table user-table" id="dataTable">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Empleado</th>
                                    <th>Contacto</th>
                                    <th>Departamento</th>
                                    <th>Area</th>
                                    <th>Oficina</th>
                                    <th>Tipo</th>
                                    <th>Acceso</th>
                                    <th>Tecnico</th>
                                    <th>Estatus</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                @if (Model.Usuarios.Count == 0) {
                                    <tr>
                                        <td colspan="11" class="empty-cell">No hay empleados registrados.</td>
                                    </tr>
                                } else {
                                    foreach (var item in Model.Usuarios) {
                                        string nombreCompleto = $"{item.Nombre} {item.App} {item.Apm}".Trim();
                                        <tr>
                                            <td>@item.IdUsuario</td>
                                            <td>@nombreCompleto</td>
                                            <td>
                                                <div class="stacked-cell">
                                                    <span>@item.Correo</span>
                                                    <small>@item.Telefono</small>
                                                </div>
                                            </td>
                                            <td>@item.NombreDepto</td>
                                            <td>@item.NombreArea</td>
                                            <td>@item.NombreOficina</td>
                                            <td>@item.NombreTipoEmpleado</td>
                                            <td>
                                                <div class="stacked-cell">
                                                    <span>@(item.TieneAcceso ? item.UsuarioAcceso : "Sin acceso")</span>
                                                    <small>@(item.TieneAcceso ? (item.AccesoActivo ? "Activo" : "Inactivo") : "")</small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="status-pill @(item.EsTecnico ? "active" : "inactive")">
                                                    @(item.EsTecnico ? "Si" : "No")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="status-pill @(item.Activo ? "active" : "inactive")">
                                                    @(item.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="row-actions">
                                                    @if (Model.PuedeActualizar) {
                                                        <button type="button"
                                                                class="icon-action"
                                                                data-edit-id="@item.IdUsuario"
                                                                data-edit-name="@item.Nombre"
                                                                data-edit-app="@item.App"
                                                                data-edit-apm="@item.Apm"
                                                                data-edit-email="@item.Correo"
                                                                data-edit-phone="@item.Telefono"
                                                                data-edit-depto="@item.IdDepto"
                                                                data-edit-area="@item.IdArea"
                                                                data-edit-office="@(item.IdOficinas?.ToString() ?? "")"
                                                                data-edit-type="@item.IdTipoEmpleado"
                                                                data-edit-tech="@item.EsTecnico.ToString().ToLower()"
                                                                aria-label="Editar empleado">
                                                            <i class="fa-solid fa-pen"></i>
                                                        </button>
                                                    }

                                                    @if (Model.PuedeCrear || item.IdUsuario == idUsuarioSesion) {
                                                        bool esAccesoPropio = item.IdUsuario == idUsuarioSesion && !Model.PuedeCrear;
                                                        <button type="button"
                                                                class="icon-action access-action @(item.TieneAcceso ? "has-access" : "no-access")"
                                                                data-access-id="@item.IdUsuario"
                                                                data-access-employee="@nombreCompleto"
                                                                data-access-has="@item.TieneAcceso.ToString().ToLower()"
                                                                data-access-login="@item.UsuarioAcceso"
                                                                data-access-active="@item.AccesoActivo.ToString().ToLower()"
                                                                data-access-self="@esAccesoPropio.ToString().ToLower()"
                                                                data-access-can-edit-active="@esAdministradorUsuarios.ToString().ToLower()"
                                                                data-access-can-restore="@Model.PuedeCrear.ToString().ToLower()"
                                                                aria-label="Administrar acceso">
                                                            <i class="fa-solid fa-key"></i>
                                                        </button>
                                                    }

                                                    @if (Model.PuedeCrear) {
                                                        <form action="@Url.Action("ToggleActivo", "usuarios")" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="idUsuario" value="@item.IdUsuario" />
                                                            <button type="submit" class="icon-action" aria-label="Cambiar estatus">
                                                                <i class="fa-solid @(item.Activo ? "fa-ban" : "fa-check")"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <div class="table-footer" id="tableFooter">
                            <div class="table-info" id="rowCount"></div>
                            <div class="pagination" id="pagination"></div>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    @if (Model.PuedeCrear) {
        <div class="modal-backdrop" id="createModal" hidden>
            <div class="modal-card user-modal" role="dialog" aria-modal="true" aria-labelledby="createTitle">
                <div class="modal-header">
                    <h2 id="createTitle">Nuevo empleado</h2>
                    <button type="button" class="modal-close" id="btnCloseCreateModal" aria-label="Cerrar">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <form action="@Url.Action("Create", "usuarios")" method="post" class="catalog-form user-form modal-user-form">
                    @Html.AntiForgeryToken()
                    <div class="form-field">
                        <label for="Nombre">Nombre</label>
                        <input id="Nombre" name="Nombre" type="text" maxlength="100" required autocomplete="off" />
                    </div>
                    <div class="form-field">
                        <label for="App">Apellido paterno</label>
                        <input id="App" name="App" type="text" maxlength="50" required autocomplete="off" />
                    </div>
                    <div class="form-field">
                        <label for="Apm">Apellido materno</label>
                        <input id="Apm" name="Apm" type="text" maxlength="50" autocomplete="off" />
                    </div>
                    <div class="form-field">
                        <label for="Correo">Correo</label>
                        <input id="Correo" name="Correo" type="email" maxlength="100" autocomplete="off" />
                    </div>
                    <div class="form-field">
                        <label for="Telefono">Telefono</label>
                        <input id="Telefono" name="Telefono" type="tel" maxlength="10" inputmode="numeric" pattern="[0-9]{10}" autocomplete="off" />
                    </div>
                    <div class="form-field">
                        <label for="IdDepto">Departamento</label>
                        <select id="IdDepto" name="IdDepto" required>
                            <option value="">Seleccione</option>
                            @foreach (var depto in Model.Departamentos) {
                                <option value="@depto.IdDepto">@depto.NombreDepto</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="IdArea">Area</label>
                        <select id="IdArea" name="IdArea" required>
                            <option value="">Seleccione</option>
                            @foreach (var area in Model.Areas) {
                                <option value="@area.IdArea">@area.NombreArea</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="IdOficinas">Oficina</label>
                        <select id="IdOficinas" name="IdOficinas">
                            <option value="">Sin oficina</option>
                            @foreach (var oficina in Model.Oficinas) {
                                <option value="@oficina.IdOficinas">@oficina.NombreOficina</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="IdTipoEmpleado">Tipo empleado</label>
                        <select id="IdTipoEmpleado" name="IdTipoEmpleado" required>
                            <option value="">Seleccione</option>
                            @foreach (var tipo in Model.TiposEmpleado) {
                                <option value="@tipo.IdTipoEmpleado">@tipo.NombreTipoEmpleado</option>
                            }
                        </select>
                    </div>
                    <label class="check-field">
                        <input type="checkbox" name="EsTecnico" value="true" />
                        <input type="hidden" name="EsTecnico" value="false" />
                        <span>Es tecnico</span>
                    </label>
                    <button type="submit" class="btn-primary">
                        <i class="fa-solid fa-plus"></i>
                        Agregar
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="modal-backdrop" id="editModal" hidden>
        <div class="modal-card user-modal" role="dialog" aria-modal="true" aria-labelledby="editTitle">
            <div class="modal-header">
                <h2 id="editTitle">Editar empleado</h2>
                <button type="button" class="modal-close" id="btnCloseModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form action="@Url.Action("Edit", "usuarios")" method="post" class="catalog-form user-form modal-user-form">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdUsuario" name="IdUsuario" />
                <div class="form-field">
                    <label for="editNombre">Nombre</label>
                    <input id="editNombre" name="Nombre" type="text" maxlength="100" required autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editApp">Apellido paterno</label>
                    <input id="editApp" name="App" type="text" maxlength="50" required autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editApm">Apellido materno</label>
                    <input id="editApm" name="Apm" type="text" maxlength="50" autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editCorreo">Correo</label>
                    <input id="editCorreo" name="Correo" type="email" maxlength="100" autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editTelefono">Telefono</label>
                    <input id="editTelefono" name="Telefono" type="tel" maxlength="10" inputmode="numeric" pattern="[0-9]{10}" autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editIdDepto">Departamento</label>
                    <select id="editIdDepto" name="IdDepto" required @soloLecturaLaboral>
                        <option value="">Seleccione</option>
                        @foreach (var depto in Model.Departamentos) {
                            <option value="@depto.IdDepto">@depto.NombreDepto</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="editIdArea">Area</label>
                    <select id="editIdArea" name="IdArea" required @soloLecturaLaboral>
                        <option value="">Seleccione</option>
                        @foreach (var area in Model.Areas) {
                            <option value="@area.IdArea">@area.NombreArea</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="editIdOficinas">Oficina</label>
                    <select id="editIdOficinas" name="IdOficinas" @soloLecturaLaboral>
                        <option value="">Sin oficina</option>
                        @foreach (var oficina in Model.Oficinas) {
                            <option value="@oficina.IdOficinas">@oficina.NombreOficina</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="editIdTipoEmpleado">Tipo empleado</label>
                    <select id="editIdTipoEmpleado" name="IdTipoEmpleado" required @soloLecturaLaboral>
                        <option value="">Seleccione</option>
                        @foreach (var tipo in Model.TiposEmpleado) {
                            <option value="@tipo.IdTipoEmpleado">@tipo.NombreTipoEmpleado</option>
                        }
                    </select>
                </div>
                @if (Model.PuedeCrear) {
                    <label class="check-field">
                        <input type="checkbox" id="editEsTecnico" name="EsTecnico" value="true" />
                        <input type="hidden" name="EsTecnico" value="false" />
                        <span>Es tecnico</span>
                    </label>
                }
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar cambios
                </button>
            </form>

        </div>
    </div>

    <div class="modal-backdrop" id="accessModal" hidden>
        <div class="modal-card access-modal" role="dialog" aria-modal="true" aria-labelledby="accessTitle">
            <div class="modal-header">
                <h2 id="accessTitle">Administrar acceso</h2>
                <button type="button" class="modal-close" id="btnCloseAccessModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form action="@Url.Action("GuardarAcceso", "usuarios")" method="post" class="catalog-form stacked">
                @Html.AntiForgeryToken()
                <input type="hidden" id="accessIdUsuario" name="IdUsuario" />
                <p class="access-employee-name" id="accessEmployeeName"></p>
                <div class="form-field">
                    <label for="accessUsuario">Usuario acceso</label>
                    <input id="accessUsuario" name="UsuarioAcceso" type="text" maxlength="50" required autocomplete="off" />
                </div>
                <label class="check-field">
                    <input type="checkbox" id="accessActivo" name="AccesoActivo" value="true" />
                    <input type="hidden" name="AccesoActivo" value="false" />
                    <span>Acceso activo</span>
                </label>
                <div class="form-field current-password-field is-hidden" id="currentPasswordField">
                    <label for="accessCurrentPassword">Contrasena actual</label>
                    <div class="password-field">
                        <input id="accessCurrentPassword" name="PasswordActual" type="password" maxlength="100" autocomplete="current-password" />
                        <button type="button" class="password-toggle" data-password-toggle="accessCurrentPassword" aria-label="Mostrar contrasena actual">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>
                <div class="form-field">
                    <label for="accessPassword">Nueva contrasena</label>
                    <div class="password-field">
                        <input id="accessPassword" name="PasswordAcceso" type="password" maxlength="100" autocomplete="new-password" />
                        <button type="button" class="password-toggle" data-password-toggle="accessPassword" aria-label="Mostrar nueva contrasena">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>
                <div class="form-field">
                    <label for="accessConfirmPassword">Confirmar nueva contrasena</label>
                    <div class="password-field">
                        <input id="accessConfirmPassword" name="ConfirmarPasswordAcceso" type="password" maxlength="100" autocomplete="new-password" />
                        <button type="button" class="password-toggle" data-password-toggle="accessConfirmPassword" aria-label="Mostrar confirmacion de contrasena">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar acceso
                </button>
            </form>

            <form action="@Url.Action("RestaurarPassword", "usuarios")" method="post" class="access-restore-form is-hidden" id="restorePasswordForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="restorePasswordIdUsuario" name="idUsuario" />
                <button type="submit" class="btn-secondary">
                    <i class="fa-solid fa-rotate-left"></i>
                    Restaurar contraseña
                </button>
            </form>
        </div>
    </div>

    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Empleados/Usuarios/usuarios.js")"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="@Url.Content("~/js/Notificaciones/notificaciones.js")"></script>
</body>
</html>
