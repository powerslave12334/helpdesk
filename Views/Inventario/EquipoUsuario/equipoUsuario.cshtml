@model HELPDESK.Models.Inventario.EquipoUsuario.equipoUsuarioModel
@{
    ViewData["Title"] = "Asignacion de equipo";
    Layout = null;
    int idUsuario = 0;
    int.TryParse(Context.Session.GetString("IdUsuario"), out idUsuario);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Asignacion de equipo - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Modulos/modulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Inventario/EquipoUsuario/equipoUsuario.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Notificaciones/notificaciones.css")" />
</head>
<body data-user-id="@idUsuario">
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Inventario</span>
                    <h1>Asignacion de equipo</h1>
                </div>
            </header>

            <section class="catalog-layout">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) {
                    <div class="catalog-alert success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    <div class="catalog-alert error">@Model.ErrorMessage</div>
                }

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Nueva asignacion</h2>
                            <p>Relaciona equipos activos con empleados y areas.</p>
                        </div>
                    </div>

                    <form action="@Url.Action("Create", "equipoUsuario")" method="post" class="catalog-form assignment-form">
                        @Html.AntiForgeryToken()
                        <div class="form-field">
                            <label for="IdEquipo">Equipo</label>
                            <select id="IdEquipo" name="IdEquipo" required>
                                <option value="">Seleccione</option>
                                @foreach (var equipo in Model.Equipos) {
                                    <option value="@equipo.IdEquipo">@equipo.NombreEquipo</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label for="IdUsuario">Usuario</label>
                            <select id="IdUsuario" name="IdUsuario" required>
                                <option value="">Seleccione</option>
                                @foreach (var usuario in Model.Usuarios) {
                                    <option value="@usuario.IdUsuario">@usuario.NombreUsuario</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label for="IdArea">Area</label>
                            <select id="IdArea" name="IdArea">
                                <option value="">Sin area</option>
                                @foreach (var area in Model.Areas) {
                                    <option value="@area.IdArea">@area.NombreArea</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label for="FechaAsignacion">Fecha asignacion</label>
                            <input id="FechaAsignacion" name="FechaAsignacion" type="date" value="@Model.FechaAsignacion.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="form-field">
                            <label for="FechaBaja">Fecha baja</label>
                            <input id="FechaBaja" name="FechaBaja" type="date" />
                        </div>
                        <div class="form-field wide">
                            <label for="Observaciones">Observaciones</label>
                            <textarea id="Observaciones" name="Observaciones" rows="2"></textarea>
                        </div>
                        <button type="submit" class="btn-primary">
                            <i class="fa-solid fa-plus"></i>
                            Asignar
                        </button>
                    </form>
                </div>

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Listado de asignaciones</h2>
                            <p>Consulta y gestiona las asignaciones de equipos.</p>
                        </div>
                        <div class="table-actions">
                            <button type="button" class="btn-primary btn-danger" id="btnDesvincularSeleccionados" disabled>
                                <i class="fa-solid fa-link-slash"></i>
                                Desvincular seleccionados
                            </button>
                            <div class="table-search">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <input type="text" id="searchInput" placeholder="Buscar por equipo, usuario, area..." />
                            </div>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table class="catalog-table assignment-table" id="assignmentTable">
                            <thead>
                                <tr>
                                    <th class="th-check">
                                        <input type="checkbox" id="selectAll" title="Seleccionar todos" />
                                    </th>
                                    <th>ID</th>
                                    <th>Equipo</th>
                                    <th>Oficina equipo</th>
                                    <th>Usuario</th>
                                    <th>Oficina usuario</th>
                                    <th>Area</th>
                                    <th>Asignacion</th>
                                    <th>Baja</th>
                                    <th>Estatus</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                @if (Model.Asignaciones.Count == 0) {
                                    <tr>
                                        <td colspan="11" class="empty-cell">No hay asignaciones registradas.</td>
                                    </tr>
                                } else {
                                    foreach (var item in Model.Asignaciones) {
                                        <tr>
                                            <td class="td-check">
                                                @if (item.Activo) {
                                                    <input type="checkbox" class="row-check" data-id="@item.IdEquipoUsuario" />
                                                }
                                            </td>
                                            <td>@item.IdEquipoUsuario</td>
                                            <td>@item.NombreEquipo</td>
                                            <td>@item.OficinaEquipo</td>
                                            <td>@item.NombreUsuario</td>
                                            <td>@item.OficinaUsuario</td>
                                            <td>@item.NombreArea</td>
                                            <td>@item.FechaAsignacion.ToString("dd/MM/yyyy")</td>
                                            <td>@(item.FechaBaja.HasValue ? item.FechaBaja.Value.ToString("dd/MM/yyyy") : "")</td>
                                            <td>
                                                <span class="status-pill @(item.Activo ? "active" : "inactive")">
                                                    @(item.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="row-actions">
                                                    <a href="@Url.Action("GenerarActa", new { id = item.IdEquipoUsuario })"
                                                       class="icon-action acta-link"
                                                       target="_blank"
                                                       aria-label="Generar acta de entrega"
                                                       title="Generar acta">
                                                        <i class="fa-solid fa-file-pdf"></i>
                                                    </a>
                                                    <button type="button"
                                                            class="icon-action relink"
                                                            data-edit-id="@item.IdEquipoUsuario"
                                                            data-edit-equipment="@item.IdEquipo"
                                                            data-edit-user="@item.IdUsuario"
                                                            data-edit-area="@(item.IdArea?.ToString() ?? "")"
                                                            data-edit-assignment="@item.FechaAsignacion.ToString("yyyy-MM-dd")"
                                                            data-edit-end="@(item.FechaBaja.HasValue ? item.FechaBaja.Value.ToString("yyyy-MM-dd") : "")"
                                                            data-edit-observations="@item.Observaciones"
                                                            aria-label="Re-vincular equipo"
                                                            title="Re-vincular">
                                                        <i class="fa-solid fa-user-pen"></i>
                                                    </button>

                                                    @if (item.Activo) {
                                                        <button type="button" class="icon-action danger" aria-label="Desvincular equipo" title="Desvincular"
                                                                data-desvincular-id="@item.IdEquipoUsuario">
                                                            <i class="fa-solid fa-link-slash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="table-footer">
                        <span class="row-count" id="rowCount"></span>
                        <div class="pagination" id="pagination"></div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <div class="modal-backdrop" id="editModal" hidden>
        <div class="modal-card assignment-modal" role="dialog" aria-modal="true" aria-labelledby="editTitle">
            <div class="modal-header">
                <h2 id="editTitle">Editar asignacion</h2>
                <button type="button" class="modal-close" id="btnCloseModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form action="@Url.Action("Edit", "equipoUsuario")" method="post" class="catalog-form assignment-form modal-assignment-form">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdEquipoUsuario" name="IdEquipoUsuario" />
                <div class="form-field">
                    <label for="editIdEquipo">Equipo</label>
                    <select id="editIdEquipo" name="IdEquipo" required>
                        <option value="">Seleccione</option>
                        @foreach (var equipo in Model.Equipos) {
                            <option value="@equipo.IdEquipo">@equipo.NombreEquipo</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="editIdUsuario">Usuario</label>
                    <select id="editIdUsuario" name="IdUsuario" required>
                        <option value="">Seleccione</option>
                        @foreach (var usuario in Model.Usuarios) {
                            <option value="@usuario.IdUsuario">@usuario.NombreUsuario</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="editIdArea">Area</label>
                    <select id="editIdArea" name="IdArea">
                        <option value="">Sin area</option>
                        @foreach (var area in Model.Areas) {
                            <option value="@area.IdArea">@area.NombreArea</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="editFechaAsignacion">Fecha asignacion</label>
                    <input id="editFechaAsignacion" name="FechaAsignacion" type="date" required />
                </div>
                <div class="form-field">
                    <label for="editFechaBaja">Fecha baja</label>
                    <input id="editFechaBaja" name="FechaBaja" type="date" />
                </div>
                <div class="form-field wide">
                    <label for="editObservaciones">Observaciones</label>
                    <textarea id="editObservaciones" name="Observaciones" rows="2"></textarea>
                </div>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar cambios
                </button>
            </form>
        </div>
    </div>

    <div class="modal-backdrop" id="motivoModal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="motivoTitle">
            <div class="modal-header">
                <h2 id="motivoTitle">Desvincular equipo</h2>
                <button type="button" class="modal-close" id="btnCloseMotivoModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <form id="motivoForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idEquipoUsuario" id="motivoIdEquipoUsuario" />
                <div class="form-field" style="margin-bottom: 16px;">
                    <label for="motivoTexto">Motivo de desvinculacion (opcional)</label>
                    <textarea id="motivoTexto" name="motivo" rows="3" placeholder="Describe el motivo..."></textarea>
                </div>
                <button type="submit" class="btn-primary btn-danger" style="width: 100%;">
                    <i class="fa-solid fa-link-slash"></i>
                    Confirmar desvinculacion
                </button>
            </form>
        </div>
    </div>

    <div class="modal-backdrop" id="motivoBulkModal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="motivoBulkTitle">
            <div class="modal-header">
                <h2 id="motivoBulkTitle">Desvincular equipos seleccionados</h2>
                <button type="button" class="modal-close" id="btnCloseMotivoBulkModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <form id="motivoBulkForm" method="post">
                @Html.AntiForgeryToken()
                <div id="motivoBulkIds"></div>
                <div class="form-field" style="margin-bottom: 16px;">
                    <label for="motivoBulkTexto">Motivo de desvinculacion (opcional)</label>
                    <textarea id="motivoBulkTexto" name="motivo" rows="3" placeholder="Describe el motivo..."></textarea>
                </div>
                <button type="submit" class="btn-primary btn-danger" style="width: 100%;">
                    <i class="fa-solid fa-link-slash"></i>
                    Confirmar desvinculacion
                </button>
            </form>
        </div>
    </div>

    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Inventario/EquipoUsuario/equipoUsuario.js?v=2")"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="@Url.Content("~/js/Notificaciones/notificaciones.js")"></script>
</body>
</html>
