@model HELPDESK.Models.Inventario.TipoEquipoCampo.tipoEquipoCampoModel
@{
    ViewData["Title"] = "Campos por tipo";
    Layout = null;
    int idUsuario = 0;
    int.TryParse(Context.Session.GetString("IdUsuario"), out idUsuario);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Campos por tipo - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Modulos/modulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Inventario/TipoEquipoCampo/tipoEquipoCampo.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Notificaciones/notificaciones.css")" />
</head>
<body data-user-id="@idUsuario">
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Inventario</span>
                    <h1>Campos por tipo</h1>
                </div>
            </header>

            <section class="catalog-layout">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) {
                    <div class="catalog-alert success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    <div class="catalog-alert error">@Model.ErrorMessage</div>
                }

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Nueva relacion</h2>
                            <p>Define que campos debe capturar cada tipo de equipo.</p>
                        </div>
                    </div>

                    <form action="@Url.Action("Create", "tipoEquipoCampo")" method="post" class="catalog-form type-field-form">
                        @Html.AntiForgeryToken()
                        <div class="form-field">
                            <label for="IdTipoEquipo">Tipo equipo</label>
                            <select id="IdTipoEquipo" name="IdTipoEquipo" required>
                                <option value="">Seleccione</option>
                                @foreach (var tipo in Model.TiposEquipo) {
                                    <option value="@tipo.IdTipoEquipo">@tipo.TipoEquipo</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label for="IdEquipoCampo">Campo</label>
                            <select id="IdEquipoCampo" name="IdEquipoCampo" required>
                                <option value="">Seleccione</option>
                                @foreach (var campo in Model.Campos) {
                                    <option value="@campo.IdEquipoCampo">@campo.EquipoCampo</option>
                                }
                            </select>
                        </div>
                        <label class="check-field">
                            <input id="Requerido" name="Requerido" type="checkbox" value="true" />
                            <input name="Requerido" type="hidden" value="false" />
                            <span>Requerido</span>
                        </label>
                        <button type="submit" class="btn-primary">
                            <i class="fa-solid fa-link"></i>
                            Relacionar
                        </button>
                    </form>
                </div>

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Listado de relaciones</h2>
                            <p>Administra los campos solicitados por tipo de equipo.</p>
                        </div>
                        <div class="table-search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" id="searchInput" placeholder="Buscar por tipo o campo..." />
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table id="dataTable" class="catalog-table type-field-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Tipo equipo</th>
                                    <th>Campo</th>
                                    <th>Requerido</th>
                                    <th>Fecha alta</th>
                                    <th>Estatus</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                @if (Model.Relaciones.Count == 0) {
                                    <tr>
                                        <td colspan="7" class="empty-cell">No hay relaciones registradas.</td>
                                    </tr>
                                } else {
                                    foreach (var item in Model.Relaciones) {
                                        <tr>
                                            <td>@item.IdTipoEquipoCampo</td>
                                            <td>@item.TipoEquipo</td>
                                            <td>@item.EquipoCampo</td>
                                            <td>
                                                <span class="status-pill @(item.Requerido ? "active" : "inactive")">
                                                    @(item.Requerido ? "Si" : "No")
                                                </span>
                                            </td>
                                            <td>@item.FechaAlta.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="status-pill @(item.Activo ? "active" : "inactive")">
                                                    @(item.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="row-actions">
                                                    <button type="button"
                                                            class="icon-action"
                                                            data-edit-id="@item.IdTipoEquipoCampo"
                                                            data-edit-type="@item.IdTipoEquipo"
                                                            data-edit-field="@item.IdEquipoCampo"
                                                            data-edit-required="@item.Requerido.ToString().ToLowerInvariant()"
                                                            aria-label="Editar relacion">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>

                                                    <form action="@Url.Action("ToggleActivo", "tipoEquipoCampo")" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idTipoEquipoCampo" value="@item.IdTipoEquipoCampo" />
                                                        <button type="submit" class="icon-action" aria-label="Cambiar estatus">
                                                            <i class="fa-solid @(item.Activo ? "fa-ban" : "fa-check")"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="table-footer" id="tableFooter">
                        <div class="table-info" id="rowCount"></div>
                        <div class="pagination" id="pagination"></div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <div class="modal-backdrop" id="editModal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="editTitle">
            <div class="modal-header">
                <h2 id="editTitle">Editar relacion</h2>
                <button type="button" class="modal-close" id="btnCloseModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form action="@Url.Action("Edit", "tipoEquipoCampo")" method="post" class="catalog-form stacked">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdTipoEquipoCampo" name="IdTipoEquipoCampo" />
                <div class="form-field">
                    <label for="editIdTipoEquipo">Tipo equipo</label>
                    <select id="editIdTipoEquipo" name="IdTipoEquipo" required>
                        <option value="">Seleccione</option>
                        @foreach (var tipo in Model.TiposEquipo) {
                            <option value="@tipo.IdTipoEquipo">@tipo.TipoEquipo</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="editIdEquipoCampo">Campo</label>
                    <select id="editIdEquipoCampo" name="IdEquipoCampo" required>
                        <option value="">Seleccione</option>
                        @foreach (var campo in Model.Campos) {
                            <option value="@campo.IdEquipoCampo">@campo.EquipoCampo</option>
                        }
                    </select>
                </div>
                <label class="check-field">
                    <input id="editRequerido" name="Requerido" type="checkbox" value="true" />
                    <input name="Requerido" type="hidden" value="false" />
                    <span>Requerido</span>
                </label>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar cambios
                </button>
            </form>
        </div>
    </div>

    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Inventario/TipoEquipoCampo/tipoEquipoCampo.js")"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="@Url.Content("~/js/Notificaciones/notificaciones.js")"></script>
</body>
</html>
