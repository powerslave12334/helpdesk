@model HELPDESK.Models.Tickets.TipoEquipoTicket.tipoEquipoTicketModel
@{
    ViewData["Title"] = "Tipo equipo ticket";
    Layout = null;
    int idUsuario = 0;
    int.TryParse(Context.Session.GetString("IdUsuario"), out idUsuario);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tipo equipo ticket - HELPDESK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/Dashboard/Principal/dashboard.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Menu/menu.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Configuracion/Modulos/modulos.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Tickets/TipoEquipoTicket/tipoEquipoTicket.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/Notificaciones/notificaciones.css")" />
</head>
<body data-user-id="@idUsuario">
    <div class="dashboard-shell">
        @await Html.PartialAsync("~/Views/Menu/menu.cshtml")

        <main class="workspace">
            <header class="workspace-header">
                <div>
                    <span class="section-label">Ticket</span>
                    <h1>Tipo equipo ticket</h1>
                </div>
            </header>

            <section class="catalog-layout">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) {
                    <div class="catalog-alert success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    <div class="catalog-alert error">@Model.ErrorMessage</div>
                }

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Nuevo tipo</h2>
                            <p>Define como una categoria de soporte debe mostrar equipos al crear tickets.</p>
                        </div>
                    </div>

                    <form action="@Url.Action("Create", "tipoEquipoTicket")" method="post" class="catalog-form ticket-equipment-type-form">
                        @Html.AntiForgeryToken()
                        <div class="form-field">
                            <label for="Clave">Clave</label>
                            <input id="Clave" name="Clave" type="text" maxlength="20" required autocomplete="off" />
                        </div>
                        <div class="form-field">
                            <label for="Descripcion">Descripcion</label>
                            <input id="Descripcion" name="Descripcion" type="text" maxlength="100" required autocomplete="off" />
                        </div>
                        <button type="submit" class="btn-primary">
                            <i class="fa-solid fa-plus"></i>
                            Agregar
                        </button>
                    </form>
                </div>

                <div class="catalog-panel">
                    <div class="catalog-panel-header">
                        <div>
                            <h2>Listado de tipos</h2>
                            <p>Administra las opciones disponibles para categoria soporte.</p>
                        </div>
                        <div class="table-search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" id="searchInput" placeholder="Buscar por clave o descripcion..." />
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table id="dataTable" class="catalog-table ticket-equipment-type-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Clave</th>
                                    <th>Descripcion</th>
                                    <th>Fecha alta</th>
                                    <th>Estatus</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                @if (Model.TiposEquipoTicket.Count == 0) {
                                    <tr>
                                        <td colspan="6" class="empty-cell">No hay tipos de equipo ticket registrados.</td>
                                    </tr>
                                } else {
                                    foreach (var item in Model.TiposEquipoTicket) {
                                        <tr>
                                            <td>@item.IdTipoEquipoTicket</td>
                                            <td>@item.Clave</td>
                                            <td>@item.Descripcion</td>
                                            <td>@item.FechaAlta.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="status-pill @(item.Activo ? "active" : "inactive")">
                                                    @(item.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="row-actions">
                                                    <button type="button"
                                                            class="icon-action"
                                                            data-edit-id="@item.IdTipoEquipoTicket"
                                                            data-edit-key="@item.Clave"
                                                            data-edit-description="@item.Descripcion"
                                                            aria-label="Editar tipo equipo ticket">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>

                                                    <form action="@Url.Action("ToggleActivo", "tipoEquipoTicket")" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idTipoEquipoTicket" value="@item.IdTipoEquipoTicket" />
                                                        <button type="submit" class="icon-action" aria-label="Cambiar estatus">
                                                            <i class="fa-solid @(item.Activo ? "fa-ban" : "fa-check")"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <div class="table-footer" id="tableFooter">
                            <div class="table-info" id="rowCount"></div>
                            <div class="pagination" id="pagination"></div>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <div class="modal-backdrop" id="editModal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="editTitle">
            <div class="modal-header">
                <h2 id="editTitle">Editar tipo equipo ticket</h2>
                <button type="button" class="modal-close" id="btnCloseModal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form action="@Url.Action("Edit", "tipoEquipoTicket")" method="post" class="catalog-form stacked">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdTipoEquipoTicket" name="IdTipoEquipoTicket" />
                <div class="form-field">
                    <label for="editClave">Clave</label>
                    <input id="editClave" name="Clave" type="text" maxlength="20" required autocomplete="off" />
                </div>
                <div class="form-field">
                    <label for="editDescripcion">Descripcion</label>
                    <input id="editDescripcion" name="Descripcion" type="text" maxlength="100" required autocomplete="off" />
                </div>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar cambios
                </button>
            </form>
        </div>
    </div>

    <script src="@Url.Content("~/js/Dashboard/Principal/dashboard.js")"></script>
    <script src="@Url.Content("~/js/Menu/menu.js")"></script>
    <script src="@Url.Content("~/js/Tickets/TipoEquipoTicket/tipoEquipoTicket.js")"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="@Url.Content("~/js/Notificaciones/notificaciones.js")"></script>
</body>
</html>
